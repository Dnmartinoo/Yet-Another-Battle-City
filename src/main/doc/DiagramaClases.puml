@startuml Diagrama_Clases_Modelo_YABC

!define INTERFACE_COLOR #E1F5FE
!define ABSTRACT_COLOR #FFF3E0
!define CONCRETE_COLOR #E8F5E8
!define ENUM_COLOR #FCE4EC

title Diagrama de Clases UML - Modelo YABC (Yet Another Battle City)

package "Física" {
    interface Cuerpo <<interface>> INTERFACE_COLOR {
        +hitbox(): Rectangulo
        +posicion(): Vector
        +setPosicion(Vector): void
        +velocidad(): Vector
    }

    class Vector CONCRETE_COLOR {
        -x: double
        -y: double
        +CERO: Vector {static}
        +Vector(double, double)
        +mas(Vector): Vector
        +por(double): Vector
        +normalizado(): Vector
        +esCero(): boolean
        +Modulo(): double
        +Modulo2(): double
    }

    class Rectangulo CONCRETE_COLOR {
        -x: double
        -y: double
        -w: double
        -h: double
        +Rectangulo(double, double, double, double)
        +intersecta(Rectangulo): boolean
        +trasladado(Vector): Rectangulo
    }

    class MundoFisico CONCRETE_COLOR {
        -TILE: int
        -anchoTiles: int
        -altoTiles: int
        -grid: Bloque[][]
        +MundoFisico(int, int, int, Bloque[][])
        +bloquesEn(Rectangulo): List<Bloque>
        +setBloque(int, int, Bloque): void
    }

    class ColisionUtils CONCRETE_COLOR {
        +colisionaConBloqueSolido(Rectangulo, MundoFisico): boolean {static}
        +ajustarX(double, double, double, Rectangulo, MundoFisico): double {static}
        +ajustarY(double, double, double, Rectangulo, MundoFisico): double {static}
        +ajustar(double, double, double, Rectangulo, MundoFisico): double {static}

    }
}

package "Personajes" {
    enum TipoPersonaje ENUM_COLOR {
        JUGADOR
        regularEnemy
        fastEnemy
        powerfulEnemy
        heavyEnemy
        -velocidad: double
        -vidaBase: int
        -cadencia: double
        +obtenerVelocidad(): double
        +vidaBase(): int
        +obtenerCadencia(): double
        +esEnemigo(): boolean
    }

    abstract class Tanque ABSTRACT_COLOR implements Cuerpo {
        #tipo: TipoPersonaje
        #vidaActual: int
        #posicion: Vector
        #hitboxLocal: Rectangulo
        #velocidadEscalar: double
        #velocidadActual: Vector
        #ultimaRotacion: double
        #ultimaDireccion: Vector
        #tile: int
        +Tanque(TipoPersonaje, Vector)
        +estaVivo(): boolean
        +recibirImpacto(int): void
        +mover(Vector, MundoFisico): void
        +rotacion(): double
        +ultimaDireccion(): Vector
        +setVelocidad(Vector): void
    }

    class Jugador CONCRETE_COLOR extends Tanque {
        -vidasRestantes: int
        -respawnPos: Vector
        -jugadorId: int
        -invulnerable: boolean {static}
        -invulnerableHasta: long {static}
        -disparoPotenciado: boolean
        -disparoPendiente: boolean
        -visible: boolean
        -inmovilizadoHastaMs: long
        +Jugador(Vector, int)
        +vidasRestantes(): int
        +setRespawn(Vector): void
        +activarInvulnerabilidadPor(long, long): void {static}
        +actualizarEstado(long): void
        +esInvulnerable(): boolean
        +sinVidas(): boolean
        +setDisparoPotenciado(boolean): void
        +tieneDisparoPotenciado(): boolean
        +setVisible(boolean): void
        +estaVisible(): boolean
        +inmovilizarPorMs(long, long): void
        +estaInmovilizado(long): boolean
        +moverArriba(): void
        +moverAbajo(): void
        +moverDerecha(): void
        +moverIzquierda(): void
        +detener(): void
        +disparar(): void
        +hayDisparoPendiente(): boolean
        +consumirDisparoPendiente(): void
        +spriteId(): String
    }

    class Enemigo CONCRETE_COLOR extends Tanque {
        -rng: Random {static}
        -direccionActual: Vector
        -tiempoConductaHasta: long
        -ultimaPosicion: Vector
        -ultimoCambioPosicion: long
        -cooldownDisparoHasta: long
        -frameAnimacion: int
        +Enemigo(TipoPersonaje, Vector)
        +actualizarIA(long, double, MundoFisico): void
        +getTipo(): TipoPersonaje
        +spriteId(): String
        -direccionAleatoria(): Vector
        -disparar(): void
    }
}

package "Entorno" {
    interface Bloque <<interface>> INTERFACE_COLOR extends Cuerpo {
        +bloqueaMovimiento(): boolean
        +bloqueaProyectiles(): boolean
        +esDestruible(): boolean
        +estaDestruido(): boolean
        +recibirImpacto(int): ResultadoImpacto
        +ocultaVisual(): boolean {default}
        +esBase(): boolean {default}
        +esLadrillo(): boolean {default}
        +esAcero(): boolean {default}
    }

    abstract class BloqueBase ABSTRACT_COLOR implements Bloque {
        #posicion: Vector
        #hitbox: Rectangulo
        #destruido: boolean
        #BloqueBase(Vector, int)
        +posicion(): Vector
        +setPosicion(Vector): void
        +hitbox(): Rectangulo
        +estaDestruido(): boolean
        +velocidad(): Vector
    }

    class Ladrillo CONCRETE_COLOR extends BloqueBase {
        -vida: int
        +Ladrillo(Vector, int)
        +bloqueaMovimiento(): boolean
        +bloqueaProyectiles(): boolean
        +esDestruible(): boolean
        +recibirImpacto(int): ResultadoImpacto
        +esLadrillo(): boolean
        +spriteId(): String
    }

    class Acero CONCRETE_COLOR extends BloqueBase {
        +Acero(Vector, int)
        +bloqueaMovimiento(): boolean
        +bloqueaProyectiles(): boolean
        +esDestruible(): boolean
        +recibirImpacto(int): ResultadoImpacto
        +esAcero(): boolean
        +spriteId(): String
    }

    class Agua CONCRETE_COLOR extends BloqueBase {
        +Agua(Vector, int)
        +bloqueaMovimiento(): boolean
        +bloqueaProyectiles(): boolean
        +esDestruible(): boolean
        +recibirImpacto(int): ResultadoImpacto
        +spriteId(): String
    }

    class Bosque CONCRETE_COLOR extends BloqueBase {
        +Bosque(Vector, int)
        +bloqueaMovimiento(): boolean
        +bloqueaProyectiles(): boolean
        +esDestruible(): boolean
        +recibirImpacto(int): ResultadoImpacto
        +ocultaVisual(): boolean
        +spriteId(): String
    }

    class Base CONCRETE_COLOR extends BloqueBase {
        +Base(Vector, int)
        +bloqueaMovimiento(): boolean
        +bloqueaProyectiles(): boolean
        +esDestruible(): boolean
        +recibirImpacto(int): ResultadoImpacto
        +esBase(): boolean
        +spriteId(): String
    }

    class ResultadoImpacto CONCRETE_COLOR {
        +balaSeDetiene(): ResultadoImpacto {static}
        +balaContinua(): ResultadoImpacto {static}
    }

    class BloqueFactory CONCRETE_COLOR {
        +crearBloque(String, Vector, int): Bloque {static}
    }
}

package "Disparo" {
    enum Equipo ENUM_COLOR {
        JUGADOR
        ENEMIGO
    }

    class Proyectil CONCRETE_COLOR implements Cuerpo, Spriteeable {
        -posicion: Vector
        -direccionUnitaria: Vector
        -velocidad: double
        -w: double
        -h: double
        -vivo: boolean
        -dano: int
        -equipo: Equipo
        -potenciada: boolean
        +Proyectil(Vector, Vector, double, int, Equipo, boolean)
        +hitbox(): Rectangulo
        +posicion(): Vector
        +setPosicion(Vector): void
        +velocidad(): Vector
        +destruir(): void
        +vivo(): boolean
        +dano(): int
        +equipo(): Equipo
        +esPotenciada(): boolean
        +spriteId(): String
    }
}

package "PowerUps" {
    interface PowerUp <<interface>> INTERFACE_COLOR {
        +aplicar(Jugador): ComandoPowerUp
        +hitbox(): Rectangulo
    }

    abstract class PowerUpBase ABSTRACT_COLOR implements PowerUp, Cuerpo {
        #posicion: Vector
        #w: double
        #h: double
        #PowerUpBase(Vector)
        +hitbox(): Rectangulo
        +posicion(): Vector
        +setPosicion(Vector): void
    }

    class Granada CONCRETE_COLOR extends PowerUpBase implements Spriteeable {
        +Granada(Vector)
        +aplicar(Jugador): ComandoPowerUp
        +velocidad(): Vector
        +spriteId(): String
    }

    class Casco CONCRETE_COLOR extends PowerUpBase implements Spriteeable{
        +Casco(Vector)
        +aplicar(Jugador): ComandoPowerUp
        +velocidad(): Vector
        +spriteId(): String
    }

    class Estrella CONCRETE_COLOR extends PowerUpBase implements Spriteeable{
        +Estrella(Vector)
        +aplicar(Jugador): ComandoPowerUp
        +velocidad(): Vector
        +spriteId(): String
    }

    interface ComandoPowerUp <<interface>> INTERFACE_COLOR implements Spriteeable{
        +ejecutar(): void
    }
}

package "Juego Core" {
    class MotorJuego CONCRETE_COLOR {
        -nivelActual: Nivel
        -campaña: List<NivelData>
        -idxNivel: int
        -factory: NivelFactory
        -fase: Fase
        -faseHastaMs: long
        -finPartida: boolean
        +MotorJuego()
        +configurarCampaña(List<NivelData>, NivelFactory): void
        +tick(long, InputEstado, InputEstado): void
        +partidaFinalizada(): boolean
        +estado(): EstadoNivel
        +nivel(): Nivel
        +enVictoria(): boolean
        +enDerrota(): boolean
        -cargarNivelDeCampañaActual(): void
        -tickJugando(long, InputEstado, InputEstado): void
        -tickVictoria(long): void
        -tickDerrota(long): void
    }

    class Nivel CONCRETE_COLOR {
        -bloques: List<Bloque>
        -enemigos: List<Enemigo>
        -jugadores: List<Jugador>
        -proyectiles: List<Proyectil>
        -poderes: List<PowerUp>
        -spawner: Spawner
        -gestorBalas: GestorBalas
        -gestorPowerUps: GestorPowerUps
        -base: Bloque
        -mundo: MundoFisico
        -limites: Rectangulo
        -victoria: boolean
        -derrota: boolean
        -numeroDeNivel: int
        +Nivel(Rectangulo, Spawner)
        +crearMundo(NivelData): void
        +tick(long, InputEstado, InputEstado): void
        +colisionaConBloqueSolido(Rectangulo): boolean
        +estado(): EstadoNivel
        +jugadores(): List<Jugador>
        +bloques(): List<Bloque>
        +enemigosVivos(): int
        +enemigosPendientes(): int
        +numeroDeNivel(): int
        +setNumeroDeNivel(int): void
    }

    class CreadorDeMundo CONCRETE_COLOR {
        + construir(NivelData): MundoConstruido
        - record MundoConstruido(Rectangulo limites, List<Bloque> bloques, List<Jugador> jugadores, Bloque base, MundoFisico mundo)
    }
        class Spawner CONCRETE_COLOR {
        -enemigosPendientes: Queue<TipoPersonaje>
        -ultimoSpawnMs: long
        -spawnsRealizados: int
        -maxSpawns: int
        -duracionSpawnMs: long
        +Spawner()
        +cargarPendientes(List<TipoPersonaje>): void
        +spawnearHastaCompletar(int, long, int): List<Enemigo>
        +cantidadPendiente(): int
        +yaTermino(): boolean
    }


class ConstructorEntidades CONCRETE_COLOR {
  - entidadFija(spriteId: String, hb: Rectangulo): EstadoEntidad
  - entidadConRot(spriteId: String, hb: Rectangulo, rot: double): EstadoEntidad
  - entidadJugador(spriteId: String, hb: Rectangulo, casco: boolean, rot: double): EstadoEntidad

  + agregarBloques(out: List<EstadoEntidad>, bloques: List<Bloque>): void
  + agregarProyectiles(out: List<EstadoEntidad>, proyectiles: List<Proyectil>): void
  + agregarEnemigos(out: List<EstadoEntidad>, enemigos: List<Enemigo>): void
  + agregarJugadores(out: List<EstadoEntidad>, jugadores: List<Jugador>): void
  + agregarPowerUps(out: List<EstadoEntidad>, poderes: List<PowerUp>): void
}




    class NivelData CONCRETE_COLOR {
        -jugador1Pos: Vector
        -jugador2Pos: Vector
        -basePos: Vector
        -bloques: Map<Vector, String>
        -enemigos: List<TipoPersonaje>
        +NivelData()
        +jugador1Pos(): Vector
        +jugador2Pos(): Vector
        +basePos(): Vector
        +bloques(): Map<Vector, String>
        +enemigos(): List<TipoPersonaje>
        +setJugador1Pos(Vector): void
        +setJugador2Pos(Vector): void
        +setBasePos(Vector): void
        +setBloques(Map<Vector, String>): void
        +setEnemigos(List<TipoPersonaje>): void
    }

    class GestorBalas CONCRETE_COLOR {
        -balaActivaPorJugador: Map<Jugador, Proyectil>
        -duenioDeBala: Map<Proyectil, Jugador>
        -sonido: ManagerSonido
        +spawnBalaJugador(Jugador, List<Proyectil>): void
        +spawnBalaEnemigo(Enemigo, List<Proyectil>): void
        +actualizar(double, List<Proyectil>, List<Enemigo>, List<Jugador>, List<Bloque>, List<PowerUp>, Rectangulo, MundoFisico): void
        +reset(): void
    }

    class GestorPowerUps CONCRETE_COLOR {
        +tick(List<PowerUp>, List<Jugador>, List<Enemigo>, Spawner): void
        +spawnearPowerUpAleatorio(Vector, List<PowerUp>): void
    }

    interface NivelFactory <<interface>> INTERFACE_COLOR {
        +crear(NivelData): Nivel
    }
}

package "Niveles" {
    class XmlNivelLoader CONCRETE_COLOR {
        +cargarNiveles(String): List<NivelData> {static}
        +cargarNivel(String): NivelData {static}
        -parseXML(String): Document {static}
        -crearNivelData(Document): NivelData {static}
    }
}

package "Audio" {
    class ManagerSonido CONCRETE_COLOR {
        -INSTANCE: ManagerSonido {static}
        -sonidos: Map<String, AudioClip>
        -musicaLoop: MediaPlayer
        -ManagerSonido()
        +get(): ManagerSonido {static}
        +cargarEfecto(String, String): void
        +cargarMusica(String): void
        +playEfecto(String): void
        +playMusica(): void
    }

}

package "Interfaces" {
    interface Spriteeable <<interface>> INTERFACE_COLOR {
        +spriteId(): String

    }

    interface Control <<interface>> INTERFACE_COLOR {
        +moverArriba(): void
        +moverAbajo(): void
        +moverDerecha(): void
        +moverIzquierda(): void
        +detener(): void
        +disparar(): void
    }
}

' Relaciones principales
Tanque --> TipoPersonaje : usa
Jugador ..|> Control : implementa
Jugador ..|> Spriteeable : implementa
Enemigo ..|> Spriteeable : implementa
Proyectil --> Equipo : usa
Proyectil ..|> Spriteeable : implementa
BloqueBase --> ResultadoImpacto : retorna
Ladrillo ..|> Spriteeable : implementa
Granada --> ComandoPowerUp : retorna
Casco --> ComandoPowerUp : retorna
Estrella --> ComandoPowerUp : retorna
Nivel --> Spawner : contiene
Nivel --> GestorBalas : contiene
Nivel --> GestorPowerUps : contiene
Nivel --> CreadorDeMundo : usa
Nivel --> ConstructorEntidades : usa
Nivel --> MundoFisico : contiene
MotorJuego --> Nivel : gestiona
MotorJuego --> NivelFactory : usa
CreadorDeMundo --> BloqueFactory : usa
XmlNivelLoader --> NivelData : crea
MundoFisico --> Bloque : contiene

' Relaciones con ManagerSonido (Singleton)
Tanque --> ManagerSonido : usa
GestorBalas --> ManagerSonido : usa
GestorPowerUps --> ManagerSonido : usa
Nivel --> ManagerSonido : usa

' Composiciones y agregaciones
MotorJuego "1" *-- "0..1" Nivel : gestiona >
MundoFisico "1" *-- "0..*" Bloque : grid >

@enduml